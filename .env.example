# Supabase (project in Singapore region)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (couple's dedicated account; scope drive.file only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in after running /admin/connect-drive
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=

# Comma-separated admin emails (also insert them into public.admin_emails)
ADMIN_EMAILS=you@example.com

# Protects /api/cron/keepalive (min 16 chars). Vercel sends it as a Bearer token.
CRON_SECRET=

# Optional Cloudflare Turnstile
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
